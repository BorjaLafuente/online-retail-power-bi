	partition Sales = m
		mode: import
		source =
				let
				  Origen = Table.Combine({#"Year 2009-2010", #"Year 2010-2011"}),
				  #"Uppercase StockCode" = Table.TransformColumns(Origen, {{"StockCode", each Text.Upper(_), type nullable text}}),
				  #"Trim StockCode" = Table.TransformColumns(#"Uppercase StockCode", {{"StockCode", each Text.Trim(_), type nullable text}}),
				  #"Add TransactionType" = Table.AddColumn(#"Trim StockCode", "TransactionType", each if Text.StartsWith([Invoice], "C") then "Cancellation" else if Text.StartsWith([Invoice], "A") then "Adjustment" else "Sale"),
				  #"Tipo de columna cambiado" = Table.TransformColumnTypes(#"Add TransactionType", {{"TransactionType", type text}}),
				  #"Add IsProduct" = Table.TransformColumnTypes(Table.AddColumn(#"Tipo de columna cambiado", "IsProduct", each not List.Contains(
				    {"POST", "DOT", "C2", "C3", "M", "m", "D", "S",
				     "BANK CHARGES", "AMAZONFEE", "CRUK",
				     "ADJUST", "ADJUST2", "B", "TEST001", "TEST002", "GIFT"},
				    [StockCode]
				)
				and not Text.StartsWith([StockCode], "GIFT_")), {{"IsProduct", type logical}}),
				  #"Add IsValidSale" = Table.TransformColumnTypes(Table.AddColumn(#"Add IsProduct", "IsValidSale", each [TransactionType] = "Sale" and [IsProduct] and [Price] > 0), {{"IsValidSale", type logical}}),
				  #"Add Date" = Table.AddColumn(#"Add IsValidSale", "Date", each DateTime.Date([InvoiceDate]), type nullable date),
				  #"Rename EIRE to Ireland" = Table.ReplaceValue(#"Add Date", "EIRE", "Ireland", Replacer.ReplaceText, {"Country"}),
				  #"Rename RSA to South Africa" = Table.ReplaceValue(#"Rename EIRE to Ireland", "RSA", "South Africa", Replacer.ReplaceText, {"Country"})
				in
				  #"Rename RSA to South Africa"

	annotation PBI_ResultType = Table


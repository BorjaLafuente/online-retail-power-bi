table _Measures
	lineageTag: e4bb016c-c404-4982-9ab3-212c97a2127e

	measure Revenue = [Gross Revenue] - [Returns]
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 40708f14-81f8-41da-97a2-9f1d801ae95f

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Orders =
			
			CALCULATE (
			    DISTINCTCOUNT ( Sales[Invoice] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: #,0
		lineageTag: af9b1f89-e755-4259-b0d0-4f1b5ee8a77e

	measure Units =
			
			CALCULATE (
			    SUM ( Sales[Quantity] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: #,0
		lineageTag: 25eaf518-9419-40e5-884a-62e1bfe5b1fd

	measure 'Average Order Value' =
			
			DIVIDE ( [Revenue], [Orders] )
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 19a2b8bd-8fb1-403e-81e5-04a432dad503

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Customers =
			
			CALCULATE (
			    DISTINCTCOUNTNOBLANK ( Sales[Customer ID] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: #,0
		lineageTag: 4f43b317-1ff8-4f1e-a472-56921f75c4cc

	measure 'Revenue PY' =
			
			VAR PeriodPY =
			    CALCULATETABLE (
			        SAMEPERIODLASTYEAR ( Calendar[Date] ),
			        Calendar[Date With Sales] = TRUE ()
			    )
			VAR FirstSalesDate =
			    CALCULATE ( MIN ( Sales[Date] ), REMOVEFILTERS () )
			RETURN
			    IF (
			        MINX ( PeriodPY, Calendar[Date] ) >= FirstSalesDate,
			        CALCULATE ( [Revenue], PeriodPY )
			    )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 64a734ba-abf2-4333-b265-52d3c5abc945

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue YoY' =
			
			VAR CurrentRevenue = [Revenue]
			VAR PreviousRevenue = [Revenue PY]
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentRevenue ) && NOT ISBLANK ( PreviousRevenue ),
			        CurrentRevenue - PreviousRevenue
			    )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 5bb59a56-0fd8-4f2d-83e6-e7cfb7e7c9c4

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue YoY %' =
			
			DIVIDE ( [Revenue YoY], [Revenue PY] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 638c0224-1164-4f3b-bb16-c2241371cde1

	measure 'Revenue YTD' =
			
			CALCULATE (
			    [Revenue],
			    DATESYTD ( Calendar[Date] )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 67dbbedd-f31f-4cfe-9835-eb5edb45707c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Gross Revenue' =
			
			CALCULATE (
			    SUMX ( Sales, Sales[Quantity] * Sales[Price] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 8f18577f-9399-4425-a9b5-3b0fd5ae71f3

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Returns =
			
			CALCULATE (
			    - SUMX ( Sales, Sales[Quantity] * Sales[Price] ),
			    Sales[TransactionType] = "Cancellation",
			    Sales[IsProduct] = TRUE ()
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 08976a6c-07bc-42b5-b876-c8b9bc5122a3

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Return Rate' =
			
			DIVIDE ( [Returns], [Gross Revenue] )
		lineageTag: 94896189-5b90-4810-94a1-78d0e2d07466

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Measures = m
		mode: import
		source =
				let
				  Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Columna 1" = _t]),
				    #"Columnas quitadas" = Table.RemoveColumns(Origen,{"Columna 1"})
				in
				  #"Columnas quitadas"

	annotation PBI_ResultType = Table


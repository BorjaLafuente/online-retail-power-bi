table _Measures
	lineageTag: e4bb016c-c404-4982-9ab3-212c97a2127e

	measure Revenue = [Gross Revenue] - [Returns]
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 40708f14-81f8-41da-97a2-9f1d801ae95f

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Orders =
			
			CALCULATE (
			    DISTINCTCOUNT ( Sales[Invoice] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: #,0
		lineageTag: af9b1f89-e755-4259-b0d0-4f1b5ee8a77e

	measure Units =
			
			CALCULATE (
			    SUM ( Sales[Quantity] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: #,0
		lineageTag: 25eaf518-9419-40e5-884a-62e1bfe5b1fd

	measure 'Average Order Value' =
			
			DIVIDE ( [Revenue], [Orders] )
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 19a2b8bd-8fb1-403e-81e5-04a432dad503

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Customers =
			
			CALCULATE (
			    DISTINCTCOUNTNOBLANK ( Sales[Customer ID] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: #,0
		lineageTag: 4f43b317-1ff8-4f1e-a472-56921f75c4cc

	measure 'Revenue PY' =
			
			VAR PeriodPY =
			    CALCULATETABLE (
			        SAMEPERIODLASTYEAR ( Calendar[Date] ),
			        Calendar[Date With Sales] = TRUE ()
			    )
			VAR FirstSalesDate =
			    CALCULATE ( MIN ( Sales[Date] ), REMOVEFILTERS () )
			RETURN
			    IF (
			        MINX ( PeriodPY, Calendar[Date] ) >= FirstSalesDate,
			        CALCULATE ( [Revenue], PeriodPY )
			    )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 64a734ba-abf2-4333-b265-52d3c5abc945

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue YoY' =
			
			VAR CurrentRevenue = [Revenue]
			VAR PreviousRevenue = [Revenue PY]
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentRevenue ) && NOT ISBLANK ( PreviousRevenue ),
			        CurrentRevenue - PreviousRevenue
			    )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 5bb59a56-0fd8-4f2d-83e6-e7cfb7e7c9c4

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue YoY %' =
			
			DIVIDE ( [Revenue YoY], [Revenue PY] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 638c0224-1164-4f3b-bb16-c2241371cde1

	measure 'Revenue YTD' =
			
			CALCULATE (
			    [Revenue],
			    DATESYTD ( Calendar[Date] )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 67dbbedd-f31f-4cfe-9835-eb5edb45707c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Gross Revenue' =
			
			CALCULATE (
			    SUMX ( Sales, Sales[Quantity] * Sales[Price] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 8f18577f-9399-4425-a9b5-3b0fd5ae71f3

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Returns =
			
			CALCULATE (
			    - SUMX ( Sales, Sales[Quantity] * Sales[Price] ),
			    Sales[TransactionType] = "Cancellation",
			    Sales[IsProduct] = TRUE ()
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 08976a6c-07bc-42b5-b876-c8b9bc5122a3

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Return Rate' =
			
			DIVIDE ( [Returns], [Gross Revenue] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 94896189-5b90-4810-94a1-78d0e2d07466

	measure 'Customer Share' =
			
			DIVIDE (
			    [Customers],
			    CALCULATE ( [Customers], REMOVEFILTERS ( Customer ) )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8a8eba7b-871d-4bd1-b05d-978f610b672e

	measure 'Revenue Share' =
			
			DIVIDE (
			    [Revenue],
			    CALCULATE ( [Revenue], REMOVEFILTERS ( Customer ), NOT ISBLANK ( Sales[Customer ID] ) )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b0b503b2-a2df-43be-81dc-1244db5349f3

	measure 'Revenue per Customer' =
			
			DIVIDE ( [Revenue], [Customers] )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 484681d0-2897-4a93-8d54-1c904d03d18f

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Avg Recency (days)' =
			
			AVERAGE ( Customer[Recency] )
		formatString: 0
		lineageTag: 8cb1a164-7038-4182-b59b-8d3eeb728ff2

	measure 'Avg Frequency' =
			
			AVERAGE ( Customer[Frequency] )
		formatString: 0.0
		lineageTag: 4376bfa2-9d3c-4ba1-9621-c313eff20908

	measure 'Insight Champions' =
			
			VAR CustomerPct = CALCULATE ( [Customer Share], Customer[Segment] = "Champions" )
			VAR RevenuePct  = CALCULATE ( [Revenue Share],  Customer[Segment] = "Champions" )
			RETURN
			    "Champions are " & FORMAT ( CustomerPct, "0%", "en-GB" )
			        & " of customers but generate " & FORMAT ( RevenuePct, "0%", "en-GB" )
			        & " of revenue."
		lineageTag: 2999bcc6-8330-4d3a-8bfe-386875c0ecf3

	measure 'Insight At Risk' =
			
			VAR ValuePerCustomer = CALCULATE ( [Revenue per Customer], Customer[Segment] = "At Risk" )
			VAR DaysSince        = CALCULATE ( [Avg Recency (days)],   Customer[Segment] = "At Risk" )
			RETURN
			    "At Risk customers are worth " & FORMAT ( ValuePerCustomer, "£#,##0", "en-GB" )
			        & " each on average but have not bought for " & FORMAT ( DaysSince, "0" )
			        & " days on average: the first target for a win-back campaign."
		lineageTag: 56a772b2-0f5a-4bf1-b4a4-06e99f44b251

	measure 'Insight Low Value' =
			
			VAR CustomerPct =
			    CALCULATE ( [Customer Share], Customer[Segment] IN { "Lost", "Hibernating" } )
			VAR RevenuePct =
			    CALCULATE ( [Revenue Share], Customer[Segment] IN { "Lost", "Hibernating" } )
			RETURN
			    "Lost and Hibernating customers are " & FORMAT ( CustomerPct, "0%", "en-GB" )
			        & " of customers but bring only " & FORMAT ( RevenuePct, "0%", "en-GB" )
			        & " of revenue."
		lineageTag: f6af6faa-53a7-46a1-a70c-7c857222d3b5

	measure 'Product Count Share' =
			
			DIVIDE (
			    COUNTROWS ( 'Product' ),
			    CALCULATE ( COUNTROWS ( 'Product' ), REMOVEFILTERS ( 'Product' ) )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 668b905b-c53a-4241-966c-53da40de779d

	measure 'Product Revenue Share' =
			
			DIVIDE (
			    SUM ( 'Product'[Product Revenue] ),
			    CALCULATE ( SUM ( 'Product'[Product Revenue] ), REMOVEFILTERS ( 'Product' ) )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 86a6a11d-2d77-4103-bc92-28498d7390b8

	measure 'UK Revenue Share' =
			
			DIVIDE (
			    CALCULATE ( [Revenue], Sales[Country] = "United Kingdom" ),
			    [Revenue]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: a633f0e6-8b34-460d-8d73-347b218cec05

	measure 'International Revenue' =
			
			CALCULATE ( [Revenue], Sales[Country] <> "United Kingdom" )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 831bc09c-0912-40c8-8c27-2e2d2114e06a

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'UK Revenue' =
			
			CALCULATE ( [Revenue], Sales[Country] = "United Kingdom" )
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: fdd8a6e7-1a47-4923-af5e-f02390b8cbb2

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Countries =
			
			CALCULATE (
			    DISTINCTCOUNT ( Sales[Country] ),
			    Sales[IsValidSale] = TRUE ()
			)
		formatString: 0
		lineageTag: 8b4b81d8-e845-4f9c-a715-ace32e14bcf7

	measure 'International Revenue Share' =
			
			DIVIDE ( [International Revenue], [Revenue] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 15feb669-0eba-4658-8910-db428af7d3ab

	partition _Measures = m
		mode: import
		source =
				let
				  Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Columna 1" = _t]),
				    #"Columnas quitadas" = Table.RemoveColumns(Origen,{"Columna 1"})
				in
				  #"Columnas quitadas"

	annotation PBI_ResultType = Table


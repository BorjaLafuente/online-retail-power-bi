{
  "name": "Online Retail",
  "dataColors": [
    "#2563EB",
    "#9CA3AF",
    "#0F766E",
    "#F59E0B",
    "#7C3AED",
    "#DC2626",
    "#16A34A",
    "#1F2A44"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#6B7280",
  "bad": "#DC2626",
  "maximum": "#1E3A8A",
  "center": "#60A5FA",
  "minimum": "#DBEAFE",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#111827" },
    "title": { "fontSize": 16, "fontFace": "Segoe UI Semibold", "color": "#111827" },
    "header": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#111827" },
    "label": { "fontSize": 12, "fontFace": "Segoe UI", "color": "#4B5563" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#EEF0F3" } } }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "shape": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
